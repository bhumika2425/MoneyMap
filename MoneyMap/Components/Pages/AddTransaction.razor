@page "/add-transactions"
@using MoneyMap.Components.Layout
@using MoneyMap.Components.Models
@layout MainLayout
@using System.Text.Json
@inject NavigationManager Navigation
@using System.Diagnostics

<div class="main-main-container">
    <div class="main-container">
        <h1 id="form-title">Add Transaction</h1>
        @if (!string.IsNullOrEmpty(InsufficientMessage))
        {
            <div class="alert alert-warning" role="alert">
                @InsufficientMessage
            </div>
        }
        <form id="transactionForm" @onsubmit="HandleSubmit">
           
            <label for="title">Title</label>
            <input type="text" id="title" placeholder="Enter Title" required @bind="transaction.Title" />

            <label for="transaction-date">Date</label>
            <input type="date" id="transaction-date" required @bind="transaction.Date" />

            <label for="transaction-type">Transaction Type</label>
            <select id="transaction-type" required @bind="transaction.Type">
                <option value="" disabled selected>Select Transaction Type</option>
                <option value="credit">Credit</option>
                <option value="debit">Debit</option>
              
            </select>

          
            <label for="amount">Amount</label>
            <input type="number" id="amount" placeholder="Enter Amount" required @bind="transaction.Amount" />

           

            
                @* Default Tags  Dropdown  *@

            <button @onclick="ToggleTagButton">
                @if (isCustomTag)
                {
                    <span>Use default tag</span>

                }
                else
                {
                    <span>Use custom tag</span>
                }
            </button>

            @if (isCustomTag)
            {
                <InputText @bind-Value="transaction.Tags" placeholder="enter custom tag"></InputText>
            }
            else
            {
                <select id="tags" required @bind="transaction.Tags">
                    <option value="" disabled selected>Select tag</option>
                    <option value="rent">Rent</option>
                    <option value="salary">Salary</option>
                    <option value="food">Food</option>
                    <option value="shopping">Shopping</option>
                </select>
            }



            @* Notes text ares *@
            <label for="notes">Notes (Optional)</label>
            <textarea id="notes" placeholder="Enter any notes" @bind="transaction.Notes"></textarea>

            <div class="button-group">
                <button type="submit" class="save-button">Save</button>
                <button type="button" class="cancel-button" @onclick="Cancel">Cancel</button>
            </div>
        </form>
    </div>

</div>

@code {
    private TransactionModel transaction = new TransactionModel { Date = DateTime.Now };
    private string InsufficientMessage = string.Empty;

    private bool isCustomTag = false;

    private void ToggleTagButton()
    {
        isCustomTag = !isCustomTag;
    }

    private async Task HandleSubmit()
    {
        try
        {
            transaction.Id = Guid.NewGuid().ToString();

            var baseDirectory = Path.Combine(FileSystem.Current.AppDataDirectory, "TransactionsData");
            if (!Directory.Exists(baseDirectory))
            {
                Directory.CreateDirectory(baseDirectory);
            }

            var filePath = Path.Combine(baseDirectory, "transactions.json");

            var transactions = new List<TransactionModel>();

            if (File.Exists(filePath))
            {
                var json = await File.ReadAllTextAsync(filePath);

                if (!string.IsNullOrWhiteSpace(json))
                {
                    try
                    {
                        transactions = JsonSerializer.Deserialize<List<TransactionModel>>(json) ?? new List<TransactionModel>();
                    }
                    catch (JsonException)
                    {
                        transactions = new List<TransactionModel>();
                    }
                }
            }

            var totalIncome = transactions.Where(t => t.Type == "credit").Sum(t => t.Amount);
            var totalExpenses = transactions.Where(t => t.Type == "debit").Sum(t => t.Amount);
            var totalBalance = totalIncome - totalExpenses;

            if (transaction.Type == "debit" && transaction.Amount > totalBalance)
            {
                InsufficientMessage = "Insufficient balance for this expense.";
                return;
            }

            transactions.Add(transaction);
            var updatedJson = JsonSerializer.Serialize(transactions);
            await File.WriteAllTextAsync(filePath, updatedJson);

            Navigation.NavigateTo("/transactions");
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"An error occurred: {ex.Message}");
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/transactions");
    }
}
}
