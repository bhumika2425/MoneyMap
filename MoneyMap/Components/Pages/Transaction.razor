@page "/transactions"
@using MoneyMap.Components.Layout
@layout MainLayout
@inject NavigationManager Navigation
@using System.Text.Json
@using MoneyMap.Components.Models
@using System.IO
@using System.Diagnostics

<div class="main-container">
    <div class="content">
        <h3>Transactions</h3>
        <div class="filters">
            <label for="date-range">Date Range:</label>
            <input type="date" id="date-range-start" name="start" @bind="startDate">
            <input type="date" id="date-range-end" name="end" @bind="endDate">
            <button @onclick="ApplyFilters">Apply</button>
            <button class="addTransactionButton" @onclick="HandleAddButton">
                Add Transaction
            </button>
        </div>
    </div>

    <div class="totals">
        <p>Total number of transactions: @totalNumberOfTransactions</p>
        <p>Total balance: Rs @totalBalance</p>
    </div>

    <div class="transaction-list">
        <div class="transaction-header">
            <input type="text" id="search" placeholder="Search by title..." @bind="searchTerm" @oninput="SearchTransactions">
            <select id="transaction-type" @bind="selectedTransactionType">
                <option value="">All</option>
                <option value="Debit">Debit</option>
                <option value="Credit">Credit</option>
                
            </select>
            <input type="text" id="tags" placeholder="Filter by tags..." @bind="tagsFilter" />
            <button @onclick="SortTransactions">Sort by Date</button>
        </div>
        <table id="transaction-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Title</th>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Tags</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transaction in filteredTransactions)
                {
                    <tr>
                        <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                        <td>@transaction.Title</td>
                        <td>@transaction.Amount</td>
                        <td>@transaction.Type</td>
                        <td>@transaction.Tags</td>
                        <td>@transaction.Notes</td>
                        <td>
                            <button @onclick="() => EditTransaction(transaction.Id)">Edit</button>
                            <button @onclick="() => DeleteTransaction(transaction.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    

</div>

@code {
    private List<TransactionModel> transactions = new List<TransactionModel>();
    private List<TransactionModel> filteredTransactions = new List<TransactionModel>();
    private string searchTerm = string.Empty;
    private DateTime? startDate = null;
    private DateTime? endDate = null;
    private string selectedTransactionType = string.Empty;
    private string tagsFilter = string.Empty;

    private int totalNumberOfTransactions => filteredTransactions.Count;


    // Calculate total income and total expenses separately
    private decimal totalIncome => transactions.Where(t => t.Type == "credit").Sum(t => t.Amount);
    private decimal totalExpenses => transactions.Where(t => t.Type == "debit").Sum(t => t.Amount);

    // Calculate balance as total income minus total expenses
    private decimal totalBalance => totalIncome - totalExpenses;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        var baseDirectory = Path.Combine(FileSystem.Current.AppDataDirectory, "TransactionsData");
        if (!Directory.Exists(baseDirectory))
        {
            Directory.CreateDirectory(baseDirectory);
            Debug.WriteLine($"Created directory: {baseDirectory}");
        }

        var filePath = Path.Combine(baseDirectory, "transactions.json");
        Debug.WriteLine($"Transaction file path: {filePath}");
        if (File.Exists(filePath))
        {
            var json = await File.ReadAllTextAsync(filePath);
            if (!string.IsNullOrWhiteSpace(json))
            {
                transactions = JsonSerializer.Deserialize<List<TransactionModel>>(json) ?? new List<TransactionModel>();
                filteredTransactions = new List<TransactionModel>(transactions);  // display all transactions but filters can be applied later
            }
        }
    }

    private void ApplyFilters()
    {
        // Apply date range filter
        filteredTransactions = transactions.Where(t =>
            (!startDate.HasValue || t.Date >= startDate.Value) &&
            (!endDate.HasValue || t.Date <= endDate.Value)
        ).ToList();

        // Apply transaction type filter
        if (!string.IsNullOrEmpty(selectedTransactionType))
        {
            filteredTransactions = filteredTransactions
                .Where(t => t.Type.Equals(selectedTransactionType, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // Apply tags filter
        if (!string.IsNullOrEmpty(tagsFilter))
        {
            filteredTransactions = filteredTransactions
                .Where(t => t.Tags != null && t.Tags.Contains(tagsFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // Apply search filter after date filtering
        SearchTransactions();

        // Debug statement to check the number of filtered transactions
        Debug.WriteLine($"Filtered transactions after applying filters: {filteredTransactions.Count}");
    }

    private void SearchTransactions()
    {
        filteredTransactions = filteredTransactions.Where(t =>
            string.IsNullOrEmpty(searchTerm) || t.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private void SortTransactions()
    {
        filteredTransactions = filteredTransactions.OrderByDescending(t => t.Date).ToList();
    }

    private void HandleAddButton()
    {
        Navigation.NavigateTo("/add-transactions");
    }

    private void EditTransaction(string transactionId)
    {
        Navigation.NavigateTo("/edit-transaction");
    }


    private void DeleteTransaction(string transactionId)
    {
        transactions.RemoveAll(t => t.Id == transactionId);
        filteredTransactions = new List<TransactionModel>(transactions);  // Refresh filtered list
        SaveTransactions();  // Save the updated list to the file
    }

    private async void SaveTransactions()
    {
        var filePath = Path.Combine(FileSystem.Current.AppDataDirectory, "TransactionsData", "transactions.json");
        var updatedJson = JsonSerializer.Serialize(transactions);
        await File.WriteAllTextAsync(filePath, updatedJson);
    }
}