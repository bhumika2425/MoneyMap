    @page "/dashboard"
    @using MoneyMap.Components.Models
    @using MoneyMap.Components.Layout
    @layout MainLayout
    @inject NavigationManager Navigation
    @using Newtonsoft.Json

    <div class="main-container">
        <h3 class="heading">Dashboard</h3>

        <section>
        <div class="stats">
            <div class="stat-card">
                <h3>Total Balance</h3>
                <p id="total-balance">Rs @totalBalance</p>
            </div>
            <div class="stat-card">
                <h3>Total Inflows</h3>
                <p id="total-inflows">Rs @totalInflows</p>
            </div>
            <div class="stat-card">
                <h3>Total Outflows</h3>
                <p id="total-outflows">Rs @totalOutflows</p>
            </div>
            <div class="stat-card">
                <h3>Total Debts</h3>
                <p id="total-debts"> Rs @totalDebts</p>
            </div>
            <div class="stat-card">
                <h3>Cleared Debts</h3>
                <p id="cleared-debts">Rs @clearedDebts</p>
            </div>
            </div>
            <div class="row1">
            <div class="r1-stat-card">
                <h3>Remaining Debts</h3>
                <p id="remaining-debts">Rs @remainingDebts</p>
            </div>
            <div class="r1-stat-card">
                <h3>Highest Inflow</h3>
                <p id="highest-transaction">Rs @highestInflow</p>
            </div>
            <div class="r1-stat-card lowest-transaction">
                <h3>Lowest Inflow</h3>
                <p id="lowest-transaction">Rs @lowestInflow</p>
            </div>
            <div class="r1-stat-card">
                <h3>Highest Outflow</h3>
                <p id="highest-transaction">Rs @highestOutflow</p>
            </div>
            </div>
            <div class="row2">
            <div class="ld-stat-card">
                <h3>Highest Debt</h3>
                <p id="highest-transaction">Rs @highestDebt</p>
            </div>
            <div class="ld-stat-card">
                <h3>Lowest Debt</h3>
                <p id="lowest-transaction">Rs @lowestDebt</p>
            </div>
            <div class="ld-stat-card">
                <h3>Lowest Outflow</h3>
                <p id="lowest-transaction">Rs @lowestOutflow</p>
            </div>
            </div>
        </section>
        <div class="transactions-container">
            <section class="transactions-section">
                <h3 style="margin-top: 50px;">Latest Transactions</h3>
                <div class="scrollable-table">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Tags</th>
                        </tr>
                    </thead>
                    <tbody id="transactions-list">
                        @foreach (var transaction in transactions)
                        {
                            <tr>
                                <td>@transaction.Title</td>
                                <td>@transaction.Type</td>
                                <td>@transaction.Amount</td>
                                <td>@transaction.Date.ToShortDateString()</td>
                                <td>@transaction.Tags</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                
            </section>
            <section class="transactions-section">
                <h3 style="margin-top: 50px;">Pending Debts </h3>
            <div class="scrollable-table">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>DebtSource</th>
                            <th>Amount</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody id="transactions-list">
                        @foreach (var debt in debts.Where(d => d.Status == "Pending"))
                        {
                            <tr>
                                <td>@debt.Title</td>
                                <td>@debt.DebtSource</td>
                                <td>@debt.Amount</td>
                                <td>@debt.Date.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
               
            
            </div>
                
            </section>
        </div>


    </div>

    @code {
        private List<TransactionModel> transactions = new List<TransactionModel>();
        private List<DebtModel> debts = new List<DebtModel>();

        public decimal totalInflows => transactions.Where(t => t.Type == "credit").Sum(t => t.Amount);
        public decimal totalOutflows => transactions.Where(t => t.Type == "debit").Sum(t => t.Amount);
        

        public decimal totalDebts => debts.Sum(d => d.Amount);
        public decimal clearedDebts => debts.Where(d => d.Status == "Cleared").Sum(d => d.Amount);
        public decimal remainingDebts => totalDebts-clearedDebts;

    public decimal totalBalance => totalInflows + remainingDebts - totalOutflows;

        private decimal highestInflow => transactions.Where(t => t.Type == "credit").Any()
            ? transactions.Where(t => t.Type == "credit").Max(t => t.Amount)
            : 0;

        private decimal lowestInflow => transactions.Where(t => t.Type == "credit").Any()
            ? transactions.Where(t => t.Type == "credit").Min(t => t.Amount)
            : 0;

        private decimal highestOutflow => transactions.Where(t => t.Type == "debit").Any()
            ? transactions.Where(t => t.Type == "debit").Max(t => t.Amount)
            : 0;

        private decimal lowestOutflow => transactions.Where(t => t.Type == "debit").Any()
            ? transactions.Where(t => t.Type == "debit").Min(t => t.Amount)
            : 0;

        private decimal highestDebt => debts.Any()
            ? debts.Max(d => d.Amount)
            : 0;

        private decimal lowestDebt => debts.Any()
            ? debts.Min(d => d.Amount)
            : 0;


        protected override async Task OnInitializedAsync()
        {
            var transactionFilePath = Path.Combine(FileSystem.Current.AppDataDirectory, "TransactionsData", "transactions.json");
            var transactionJson = await File.ReadAllTextAsync(transactionFilePath);
            transactions = string.IsNullOrWhiteSpace(transactionJson) ? new List<TransactionModel>() : JsonConvert.DeserializeObject<List<TransactionModel>>(transactionJson) ?? new List<TransactionModel>();

            var debtFilePath = Path.Combine(FileSystem.Current.AppDataDirectory, "DebtData", "debts.json");
            var debtJson = await File.ReadAllTextAsync(debtFilePath);
            debts = string.IsNullOrWhiteSpace(debtJson) ? new List<DebtModel>() : JsonConvert.DeserializeObject<List<DebtModel>>(debtJson) ?? new List<DebtModel>();

            // Sort transactions and debts by Date in descending order
            transactions = transactions.OrderByDescending(t => t.Date).ToList();
            debts = debts.OrderByDescending(d => d.Date).ToList();
        }
    }