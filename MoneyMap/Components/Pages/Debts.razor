@page "/debts"
@using MoneyMap.Components.Layout
@layout MainLayout
@using System.Text.Json
@using MoneyMap.Components.Models
@inject NavigationManager Navigation
@using System.Diagnostics
@using Newtonsoft.Json
@inject IJSRuntime JSRuntime

<body>
    <div class="heading">
        <h3 class="h3heading">Debt Management</h3>
        <button class="add-debt-btn" @onclick="NavigateToAddDebtForm">Add Debt</button>
    </div>
    <!-- Summary Section -->
    <div class="summary">
        <div class="card">
            <p>Total Debts</p>
            <h3>Rs @totalDebts</h3>
            
        </div>
        <div class="card">
            <p>Cleared Debts</p>
            <h3>Rs @clearedDebts</h3>
            
        </div>
        <div class="card">
            <p>Pending Debts</p>
            <h3>Rs @pendingDebts</h3>
            
        </div>
    </div>
    <!-- Debt Table Section -->
    <h3>Your Debts</h3>
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Amount(Rs)</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (debts.Count > 0)
                {
                    @foreach (var debt in debts)
                    {
                        <tr>
                            <td>@debt.DebtSource</td>
                            <td>@debt.Amount</td>
                            <td>@debt.DueDate.ToShortDateString()</td>
                            <td>
                                @if (debt.Status == "Pending")
                                {
                                    <span style="color: #dc3545;">Pending</span>
                                }
                                else
                                {
                                    <span style="color: #28a745;">Cleared</span>
                                }
                            </td>
                            <td>
                                @if (debt.Status == "Pending")
                                {
                                    <button class="action-btn" @onclick="() => ClearDebtAsync(debt)">Clear</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="no-data">
                        <td colspan="5">No debts available. Please add new debts to keep track of them.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
@code {
    private List<TransactionModel> transactions = new List<TransactionModel>();
    private List<DebtModel> debts = new List<DebtModel>();

    public decimal totalInflows => transactions.Where(t => t.Type == "credit").Sum(t => t.Amount);
    public decimal totalOutflows => transactions.Where(t => t.Type == "debit").Sum(t => t.Amount);

    public decimal totalBalance => totalInflows + pendingDebts - totalOutflows;

    private decimal totalDebts => debts.Where(d => d.Status != "Cleared").Sum(d => d.Amount);
    private decimal clearedDebts => debts.Where(d => d.Status == "Cleared").Sum(d => d.Amount);
    private decimal pendingDebts => totalDebts - clearedDebts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var transactionFilePath = Path.Combine(FileSystem.Current.AppDataDirectory, "TransactionsData", "transactions.json");
            var transactionJson = await File.ReadAllTextAsync(transactionFilePath);
            transactions = string.IsNullOrWhiteSpace(transactionJson) ? new List<TransactionModel>() : JsonConvert.DeserializeObject<List<TransactionModel>>(transactionJson) ?? new List<TransactionModel>();


            var baseDirectory = Path.Combine(FileSystem.Current.AppDataDirectory, "DebtData");
            var filePath = Path.Combine(baseDirectory, "debts.json");

            if (File.Exists(filePath))
            {
                var json = await File.ReadAllTextAsync(filePath);
                debts = string.IsNullOrWhiteSpace(json)
                    ? new List<DebtModel>()
                    : JsonConvert.DeserializeObject<List<DebtModel>>(json) ?? new List<DebtModel>();
            }
            else
            {
                Debug.WriteLine("Debt file does not exist.");
                debts = new List<DebtModel>();
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error loading debts: {ex.Message}");
        }
    }
    private void NavigateToAddDebtForm()
    {
        Navigation.NavigateTo("/add-debts");
    }

    private async Task ClearDebtAsync(DebtModel debt)
    {
        if (debt == null) return;

        if (totalBalance >= debt.Amount)
        {
            debt.Status = "Cleared";  // Update the debt status to "Cleared"
            await SaveDebtsToFileAsync();  // Save the updated debts list to the file
            StateHasChanged();  // Trigger re-rendering to update the UI

            // Show success message
            await JSRuntime.InvokeVoidAsync("alert", "Debt cleared successfully.");
        }
        else
        {
            // Show alert message for insufficient balance
            await JSRuntime.InvokeVoidAsync("alert", "Not enough balance to clear the debt.");
        }
    }



    private async Task SaveDebtsToFileAsync()
    {
        try
        {
            var baseDirectory = Path.Combine(FileSystem.Current.AppDataDirectory, "DebtData");
            var filePath = Path.Combine(baseDirectory, "debts.json");

            var updatedJson = JsonConvert.SerializeObject(debts, Formatting.Indented);
            await File.WriteAllTextAsync(filePath, updatedJson);

            Debug.WriteLine($"Debt file successfully updated at {filePath}. Content: {updatedJson}");
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error saving debts: {ex.Message}");
        }
    }

}