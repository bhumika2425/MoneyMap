@page "/login"
@using MoneyMap.Components.Layout
@using MoneyMap.Components.Models
@layout SimpleLayout
@inject NavigationManager Navigation

<body>
    <div class="setup-container">
        <h4 class="login-header">Welcome! Set Up Your Expense Tracker</h4>
        <form>
            <input id="username" type="text" class="form-control" @bind="loginModel.Username" placeholder="Enter Username" />
            <input id="password" type="password" class="form-control" @bind="loginModel.Password" placeholder="Enter Password" />
            <select id="currency" @bind="loginModel.PreferredCurrency" required>
                <option value="" disabled>Select Preferred Currency</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="NPR">NPR</option>
                <option value="INR">INR</option>
            </select>
            <button type="button" class="login-button" @onclick="HandleLogin">Login</button>
        </form>

        @if (showErrorMessage)
        {
            <div class="error-message" style="color: red; margin-top: 10px;">
                <p>Incorrect username, password, or currency. Please try again.</p>
            </div>
        }
    </div>
</body>

@code {
