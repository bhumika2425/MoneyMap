@page "/"
@using MoneyMap.Components.Layout
@layout SimpleLayout
@inject NavigationManager Navigation

<body>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Take Control of Your Finances with MoneyMap</h1>
            <p>Track your spending, set budgets, and achieve your financial goals.</p>
            <a href="#get-started" class="hero-btn" @onclick="NavigateToLogin">Get Started</a>
        </div>
    </section>
</body>

@code {
    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}

