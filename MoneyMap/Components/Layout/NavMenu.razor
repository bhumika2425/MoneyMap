@inject NavigationManager NavigationManager

<input type="checkbox" title="Navigation menu" id="nav-toggle" class="navbar-toggler" />

<div class="nav-scrollable">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">MoneyMap</a>
        </div>
    </div>

    <nav class="side-nav flex-column">
        <div class="nav-item px-3">
            <button class="nav-button" @onclick="navButtonNavigateToDashboard">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Dashboard
            </button>
        </div>
        <div class="nav-item px-3">
            <button class="nav-button" @onclick="navButtonNavigateToTransaction">
                <span class="bi bi-cash-stack" aria-hidden="true"></span> Transaction
            </button>
        </div>
        <div class="nav-item px-3">
            <button class="nav-button" @onclick="navButtonNavigateToDebt">
                <span class="bi bi-wallet2" aria-hidden="true"></span> Debts
            </button>
        </div>
        <div class="nav-item px-3">
            <button class="nav-button" @onclick="navButtonNavigateToReport">
                <span class="bi bi-graph-up" aria-hidden="true"></span> Reports
            </button>
        </div>
        <div class="nav-item px-3">
            <button class="nav-button" @onclick="navButtonNavigateToSetting">
                <span class="bi bi-gear" aria-hidden="true"></span> Settings
            </button>
        </div>
    </nav>
</div>

@code {
    private void navButtonNavigateToDashboard()
    {
        NavigationManager.NavigateTo("/dashboard");
    }
    private void navButtonNavigateToTransaction()
    {
        NavigationManager.NavigateTo("/transactions");
    }
    private void navButtonNavigateToDebt()
    {
        NavigationManager.NavigateTo("/debts");
    }
    private void navButtonNavigateToReport()
    {
        NavigationManager.NavigateTo("/reports");
    }
    private void navButtonNavigateToSetting()
    {
        NavigationManager.NavigateTo("/settings");
    }
}
